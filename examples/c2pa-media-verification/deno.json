{
  "imports": {
    "anchr-sdk": "../../packages/sdk/src/index.ts"
  },
  "tasks": {
    "check": "deno check --config ../../deno.json requester.ts worker.ts",
    "test": "deno test --config ../../deno.json --allow-read env-example.test.ts",
    "smoke": "deno task check && deno task test",
    "requester": "deno run --allow-all --env requester.ts",
    "worker": "deno run --allow-all --env worker.ts"
  }
}
