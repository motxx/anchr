# Local non-production defaults for the C2PA media verification example.
NOSTR_RELAYS=ws://localhost:7777
CASHU_MINT_URL=http://localhost:3338
ORACLE_ENDPOINT=http://localhost:3001
ORACLE_PUBKEY=<oracle-pubkey-hex-or-npub>
ORACLE_API_KEY=<optional-oracle-api-key>

C2PA_PROVIDER_PRIVKEY=<provider-nsec-or-hex>
C2PA_PHOTO_PATH=./signed-photo.jpg
C2PA_SOURCE_PROOFS_JSON=[{"placeholder":"replace-with-testnet-cashu-proof"}]
C2PA_PROVIDER_PUBKEY=

C2PA_LOCATION_HINT="Shibuya, Tokyo"
C2PA_EXPECTED_LAT=35.6595
C2PA_EXPECTED_LON=139.7004
C2PA_MAX_DISTANCE_KM=0.5
C2PA_FRESHNESS_SECONDS=600
C2PA_MAX_SATS=100
C2PA_OFFER_SATS=100
LOCKTIME_SECONDS=3600
OFFER_WINDOW_MS=30000
RESULT_TIMEOUT_MS=600000
SELECTION_TIMEOUT_MS=120000
PREIMAGE_TIMEOUT_MS=300000
