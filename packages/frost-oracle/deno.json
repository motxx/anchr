{
  "name": "@anchr/frost-oracle",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./config": "./src/config.ts",
    "./dual-outcome-config": "./src/dual-outcome-config.ts",
    "./coordinator": "./src/coordinator.ts",
    "./signing-coordinator": "./src/signing-coordinator.ts",
    "./frost-cli": "./src/frost-cli.ts"
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "@logtape/logtape": "jsr:@logtape/logtape@^2",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/expect": "jsr:@std/expect@^1"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "SPEC.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys"
  }
}
