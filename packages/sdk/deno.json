{
  "name": "@anchr/sdk",
  "version": "0.0.1",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters/mod.ts",
    "./adapters/cashu": "./src/adapters/cashu.ts",
    "./adapters/nostr": "./src/adapters/nostr/mod.ts",
    "./adapters/oracle-client": "./src/adapters/oracle-client/index.ts",
    "./adapters/oracle-service": "./src/adapters/oracle-service/index.ts",
    "./adapters/storage": "./src/adapters/storage.ts",
    "./attachments": "./src/attachments/mod.ts",
    "./attachments/blossom": "./src/attachments/blossom.ts",
    "./payments": "./src/payments/mod.ts",
    "./proofs": "./src/proofs/mod.ts",
    "./schema": "./src/schema.ts",
    "./customer": "./src/customer.ts",
    "./provider": "./src/provider.ts",
    "./oracle": "./src/oracle.ts"
  },
  "imports": {
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/expect": "jsr:@std/expect@^1",
    "@noble/hashes/sha2.js": "jsr:@noble/hashes@^2/sha2.js",
    "@noble/hashes/utils.js": "jsr:@noble/hashes@^2/utils.js",
    "@cashu/cashu-ts": "npm:@cashu/cashu-ts@^3",
    "@anchr/protocol": "../protocol/src/mod.ts",
    "@anchr/protocol/events": "../protocol/src/events.ts",
    "@anchr/protocol/nostr": "../protocol/src/nostr.ts",
    "@anchr/protocol/schema": "../protocol/src/schema.ts",
    "@anchr/protocol/types": "../protocol/src/types.ts",
    "nostr-tools/pool": "npm:nostr-tools@^2/pool",
    "nostr-tools/pure": "npm:nostr-tools@^2/pure",
    "nostr-tools/nip19": "npm:nostr-tools@^2/nip19",
    "nostr-tools/nip44": "npm:nostr-tools@^2/nip44"
  },
  "publish": {
    "include": [
      "src/index.ts",
      "src/adapters/**/*.ts",
      "src/attachments/**/*.ts",
      "src/payments/**/*.ts",
      "src/proofs/**/*.ts",
      "src/internal/runtime/**/*.ts",
      "src/schema.ts",
      "src/customer.ts",
      "src/customer-types.ts",
      "src/provider.ts",
      "src/provider-types.ts",
      "src/oracle.ts",
      "src/client.ts",
      "src/client-types.ts",
      "src/errors.ts",
      "README.md",
      "deno.json"
    ],
    "exclude": [
      "src/*.test.ts",
      "dist/",
      "tsconfig.json",
      "package.json"
    ]
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-net src/"
  }
}
