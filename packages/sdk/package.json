{
  "name": "@anchr/sdk",
  "version": "0.0.1",
  "type": "module",
  "description": "SDK for Anchr — verified-data purchase between pseudonymous parties over Nostr",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node && bun build src/worker.ts --outdir dist --target node && bunx tsc -p tsconfig.json",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["tlsnotary", "oracle", "cashu", "lightning", "nostr", "nip-90", "verified-data"],
  "license": "MIT"
}
