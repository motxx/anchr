{
  "name": "@anchr/sdk",
  "version": "0.0.1",
  "type": "module",
  "description": "SDK for Anchr — verified-data purchase between pseudonymous parties over Nostr",
  "main": "dist/index.js",
  "types": "dist/sdk/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./customer": {
      "types": "./dist/sdk/src/customer.d.ts",
      "import": "./dist/customer.js",
      "default": "./dist/customer.js"
    },
    "./provider": {
      "types": "./dist/sdk/src/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./oracle": {
      "types": "./dist/sdk/src/oracle.d.ts",
      "import": "./dist/oracle.js",
      "default": "./dist/oracle.js"
    },
    "./adapters/cashu-browser": {
      "types": "./dist/sdk/src/adapters/cashu-browser.d.ts",
      "import": "./dist/adapters/cashu-browser.js",
      "default": "./dist/adapters/cashu-browser.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun run clean && bun run scripts/build-bundle.ts && bunx tsc -p tsconfig.json && bun run scripts/fix-dts-imports.ts",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tlsnotary",
    "oracle",
    "cashu",
    "lightning",
    "nostr",
    "nip-90",
    "verified-data"
  ],
  "license": "MIT",
  "dependencies": {
    "@cashu/cashu-ts": "^3",
    "@logtape/logtape": "^2.1.1",
    "@noble/hashes": "^2.2.0",
    "hono": "^4.12.23",
    "nostr-tools": "^2.23.5"
  }
}
