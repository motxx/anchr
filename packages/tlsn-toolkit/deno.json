{
  "name": "@anchr/tlsn-toolkit",
  "version": "0.1.0",
  "exports": {
    ".": "./src/tlsn-validation.ts",
    "./tlsn-validation": "./src/tlsn-validation.ts",
    "./tlsn-types": "./src/tlsn-types.ts",
    "./proof-redaction": "./src/proof-redaction.ts"
  },
  "imports": {
    "@logtape/logtape": "jsr:@logtape/logtape@^2",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/expect": "jsr:@std/expect@^1"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "SPEC.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys"
  }
}
