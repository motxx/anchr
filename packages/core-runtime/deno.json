{
  "name": "@anchr/core-runtime",
  "version": "0.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./mod": "./src/mod.ts",
    "./fs": "./src/fs.ts",
    "./process": "./src/process.ts",
    "./which": "./src/which.ts",
    "./env": "./src/env.ts",
    "./runtime": "./src/runtime.ts",
    "./logger": "./src/logger.ts"
  },
  "imports": {
    "@logtape/logtape": "jsr:@logtape/logtape@^2"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "deno.json"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "strict": true
  },
  "tasks": {
    "test": "deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys"
  }
}
