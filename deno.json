{
  "workspace": [
    "./packages/core-runtime",
    "./packages/core-cashu",
    "./packages/tlsn-toolkit",
    "./packages/photo-verification",
    "./packages/frost-oracle",
    "./packages/cashu-conditional-swap",
    "./packages/blossom",
    "./packages/protocol",
    "./packages/oracle-sdk",
    "./packages/customer-sdk",
    "./packages/provider-sdk",
    "./packages/bounty",
    "./packages/sdk",
    "./example/c2pa-media-verification",
    "./example/airdrop-bot-shield",
    "./example/tlsn-fiat-swap-square"
  ],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true
  },
  "imports": {
    "hono": "jsr:@hono/hono@^4",
    "hono/cors": "jsr:@hono/hono@^4/cors",
    "hono/deno": "jsr:@hono/hono@^4/deno",
    "zod": "jsr:@zod/zod@^4",
    "@noble/hashes/sha2.js": "jsr:@noble/hashes@^2/sha2.js",
    "@noble/hashes/utils.js": "jsr:@noble/hashes@^2/utils.js",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/testing/mock": "jsr:@std/testing@^1/mock",
    "@std/expect": "jsr:@std/expect@^1",
    "@cashu/cashu-ts": "npm:@cashu/cashu-ts@^3",
    "@db/sqlite": "jsr:@db/sqlite@^0.12",
    "nostr-tools": "npm:nostr-tools@^2",
    "nostr-tools/pool": "npm:nostr-tools@^2/pool",
    "nostr-tools/filter": "npm:nostr-tools@^2/filter",
    "nostr-tools/core": "npm:nostr-tools@^2/core",
    "nostr-tools/nip19": "npm:nostr-tools@^2/nip19",
    "nostr-tools/nip44": "npm:nostr-tools@^2/nip44",
    "nostr-tools/pure": "npm:nostr-tools@^2/pure",
    "@noble/curves/secp256k1": "npm:@noble/curves@^2/secp256k1.js",
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.78",
    "@anchr/protocol": "./packages/protocol/src/mod.ts",
    "@anchr/protocol/capabilities": "./packages/protocol/src/capabilities.ts",
    "@anchr/protocol/events": "./packages/protocol/src/events.ts",
    "@anchr/protocol/nostr": "./packages/protocol/src/nostr.ts",
    "@anchr/protocol/schema": "./packages/protocol/src/schema.ts",
    "@anchr/protocol/types": "./packages/protocol/src/types.ts",
    "@anchr/oracle-sdk": "./packages/oracle-sdk/src/mod.ts",
    "@anchr/oracle-sdk/oracle": "./packages/oracle-sdk/src/oracle.ts",
    "@anchr/customer-sdk": "./packages/customer-sdk/src/mod.ts",
    "@anchr/customer-sdk/cashu": "./packages/customer-sdk/src/cashu.ts",
    "@anchr/customer-sdk/customer": "./packages/customer-sdk/src/customer.ts",
    "@anchr/customer-sdk/nostr": "./packages/customer-sdk/src/nostr.ts",
    "@anchr/customer-sdk/types": "./packages/customer-sdk/src/types.ts",
    "@anchr/provider-sdk": "./packages/provider-sdk/src/mod.ts",
    "@anchr/provider-sdk/cashu": "./packages/provider-sdk/src/cashu.ts",
    "@anchr/provider-sdk/nostr": "./packages/provider-sdk/src/nostr.ts",
    "@anchr/provider-sdk/provider": "./packages/provider-sdk/src/provider.ts",
    "@anchr/provider-sdk/types": "./packages/provider-sdk/src/types.ts",
    "@anchr/anchr-mcp": "./example/anchr-mcp/src/mcp-server.ts",
    "@anchr/anchr-mcp/mcp-query-backend": "./example/anchr-mcp/src/mcp-query-backend.ts",
    "@anchr/anchr-mcp/mcp-server": "./example/anchr-mcp/src/mcp-server.ts",
    "@modelcontextprotocol/sdk/client/index.js": "npm:@modelcontextprotocol/sdk@^1/client/index.js",
    "@modelcontextprotocol/sdk/client/stdio.js": "npm:@modelcontextprotocol/sdk@^1/client/stdio.js",
    "@modelcontextprotocol/sdk/server/mcp.js": "npm:@modelcontextprotocol/sdk@^1/server/mcp.js",
    "@modelcontextprotocol/sdk/server/stdio.js": "npm:@modelcontextprotocol/sdk@^1/server/stdio.js",
    "@modelcontextprotocol/sdk/shared/transport.js": "npm:@modelcontextprotocol/sdk@^1/shared/transport.js",
    "@modelcontextprotocol/sdk/types.js": "npm:@modelcontextprotocol/sdk@^1/types.js",
    "@logtape/logtape": "jsr:@logtape/logtape@^2",
    "react": "npm:react@^19",
    "react-dom": "npm:react-dom@^19",
    "react-dom/client": "npm:react-dom@^19/client",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5",
    "@tanstack/query-core": "npm:@tanstack/query-core@^5",
    "lucide-react": "npm:lucide-react@^0.577",
    "radix-ui": "npm:radix-ui@^1",
    "clsx": "npm:clsx@^2",
    "tailwind-merge": "npm:tailwind-merge@^3",
    "class-variance-authority": "npm:class-variance-authority@^0.7",
    "puppeteer": "npm:puppeteer@^24",
    "playwright": "npm:playwright@^1.58",
    "esbuild": "npm:esbuild@^0.25",
    "tailwindcss": "npm:tailwindcss@^4.2.2",
    "anchr-sdk": "./packages/sdk/src/index.ts"
  },
  "unstable": ["sloppy-imports", "detect-cjs"],
  "tasks": {
    "check": "deno check packages/ e2e/ scripts/",
    "test": "deno task test:unit && deno task test:integration && deno task test:e2e:protocol && deno task test:scripts && deno task test:examples",
    "publish:dry-run": "deno publish --dry-run --allow-dirty --config packages/core-runtime/deno.json && deno publish --dry-run --allow-dirty --config packages/core-cashu/deno.json && deno publish --dry-run --allow-dirty --config packages/tlsn-toolkit/deno.json && deno publish --dry-run --allow-dirty --config packages/photo-verification/deno.json && deno publish --dry-run --allow-dirty --config packages/frost-oracle/deno.json && deno publish --dry-run --allow-dirty --config packages/cashu-conditional-swap/deno.json && deno publish --dry-run --allow-dirty --config packages/blossom/deno.json && deno publish --dry-run --allow-dirty --config packages/protocol/deno.json && deno publish --dry-run --allow-dirty --config packages/oracle-sdk/deno.json && deno publish --dry-run --allow-dirty --config packages/customer-sdk/deno.json && deno publish --dry-run --allow-dirty --config packages/provider-sdk/deno.json && deno publish --dry-run --allow-dirty --config packages/bounty/deno.json && deno publish --dry-run --allow-dirty --config packages/sdk/deno.json",
    "test:unit": "deno test packages/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys '--ignore=**/*.integration.test.ts'",
    "test:integration": "bash -c 'files=$(find packages -name \"*.integration.test.ts\" -type f); if [ -z \"$files\" ]; then echo \"No package integration tests\"; exit 0; fi; deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys $files'",
    "test:scripts": "deno test scripts/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:examples": "deno test --allow-all example/ --ignore=example/expo-worker-app",

    "test:e2e:protocol": "deno test e2e/protocol/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:relay": "ANCHR_E2E_REQUIRE_INFRA=1 deno test e2e/relay/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:regtest": "ANCHR_E2E_REQUIRE_INFRA=1 deno test e2e/regtest/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys --allow-ffi",
    "test:e2e:frost": "FROST_E2E_REQUIRE_CORE=1 deno test e2e/frost/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:tlsn": "TLSN_E2E_REQUIRE_CORE=1 deno test e2e/tlsn/ --allow-all",

    "test:all": "./scripts/test-all.sh --local",
    "test:all:docker": "./scripts/test-all.sh --docker",
    "test:all:full": "./scripts/test-all.sh full",

    "lint": "deno lint",
    "lint:strict": "deno lint && deno task lint:fmt && deno task lint:arch && deno task lint:invariants && deno task lint:paths && deno task lint:types && deno task lint:deprecation && deno task lint:no-history-comments && deno task lint:no-dynamic-import && deno task lint:no-test-sanitizer-bypass && deno task lint:no-unit-network-listener",
    "lint:deps": "bash scripts/cargo-audit-all.sh",
    "lint:fmt": "deno run --allow-read --allow-run scripts/lint-fmt.ts",
    "lint:arch": "deno run --allow-read scripts/arch-lint.ts",
    "lint:arch:candidates": "deno run --allow-read scripts/arch-lint-candidates.ts",
    "lint:invariants": "deno run --allow-read scripts/lint-invariants.ts",
    "lint:paths": "deno run --allow-read --allow-env --allow-run scripts/check-no-local-paths.ts",
    "lint:refactor": "deno run --allow-read scripts/refactor-lint.ts",
    "lint:types": "deno run --allow-read scripts/lint-types.ts",
    "lint:deprecation": "deno run --allow-read --allow-env --allow-run scripts/lint-deprecation.ts",
    "lint:no-history-comments": "deno run --allow-read --allow-env --allow-run scripts/lint-no-history-comments.ts",
    "lint:no-dynamic-import": "deno run --allow-read --allow-env --allow-run scripts/lint-no-dynamic-import.ts",
    "lint:no-test-sanitizer-bypass": "deno run --allow-read --allow-run scripts/lint-no-test-sanitizer-bypass.ts",
    "lint:no-unit-network-listener": "deno run --allow-read --allow-run scripts/lint-no-unit-network-listener.ts",
    "setup:hooks": "git config core.hooksPath scripts/git-hooks && echo '✓ git hooks installed (core.hooksPath → scripts/git-hooks)'",
    "build:ui": "deno run --allow-all scripts/build-ui.ts",
    "build:css": "deno run --allow-all scripts/build-css.ts",
    "fiat-swap:buyer": "deno run --node-modules-dir=false --no-lock --allow-env --allow-net --allow-read example/tlsn-fiat-swap-square/buyer.ts",
    "fiat-swap:seller": "deno run --node-modules-dir=false --no-lock --allow-env --allow-net example/tlsn-fiat-swap-square/seller.ts",
    "fiat-swap:check": "deno check --node-modules-dir=false --no-lock example/tlsn-fiat-swap-square/buyer.ts example/tlsn-fiat-swap-square/seller.ts example/tlsn-fiat-swap-square/fiat-swap.ts example/tlsn-fiat-swap-square/fiat-swap.test.ts",
    "fiat-swap:test": "deno test --node-modules-dir=false --no-lock --allow-read example/tlsn-fiat-swap-square/fiat-swap.test.ts",
    "setup:tlsn-ext": "git clone https://github.com/motxx/tlsn-extension.git /tmp/tlsn-extension 2>/dev/null || (cd /tmp/tlsn-extension && git pull) && cd /tmp/tlsn-extension && npm install && npm run build"
  },
  "exclude": [
    "example/expo-worker-app",
    "node_modules",
    "dist/",
    "example/two-party-binary-bet/src/demo.ts",
    "example/two-party-binary-bet/src/nostr-market.ts",
    "example/two-party-binary-bet/ui/main.js",
    "example/two-party-binary-bet/ui/main.js.map"
  ],
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-eval",
        "no-self-compare",
        "default-param-last"
      ],
      "exclude": [
        "no-unused-vars",
        "require-await",
        "no-explicit-any",
        "no-slow-types",
        "jsx-button-has-type",
        "no-import-prefix"
      ]
    },
    "exclude": [
      "example/expo-worker-app",
      "example/two-party-binary-bet/src/demo.ts",
      "example/two-party-binary-bet/src/nostr-market.ts",
      "example/two-party-binary-bet/ui/main.js",
      "example/two-party-binary-bet/ui/main.js.map",
      "dist/",
      "scripts/",
      "packages/bounty/src/infrastructure/log-stream.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "example/expo-worker-app",
      "docs",
      "docs/issues",
      "*.md",
      "skills",
      ".claude/skills",
      ".codex/skills"
    ]
  },
  "nodeModulesDir": "auto"
}
