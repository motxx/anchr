{
  "workspace": [
    "./packages/protocol",
    "./packages/sdk",
    "./examples/paid-request-simulation",
    "./examples/quick-start"
  ],
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true
  },
  "imports": {
    "@noble/hashes/sha2.js": "jsr:@noble/hashes@^2/sha2.js",
    "@noble/hashes/utils.js": "jsr:@noble/hashes@^2/utils.js",
    "@std/testing/bdd": "jsr:@std/testing@^1/bdd",
    "@std/expect": "jsr:@std/expect@^1",
    "@cashu/cashu-ts": "npm:@cashu/cashu-ts@^3",
    "nostr-tools": "npm:nostr-tools@^2",
    "nostr-tools/pool": "npm:nostr-tools@^2/pool",
    "nostr-tools/filter": "npm:nostr-tools@^2/filter",
    "nostr-tools/core": "npm:nostr-tools@^2/core",
    "nostr-tools/pure": "npm:nostr-tools@^2/pure",
    "@noble/curves/secp256k1": "npm:@noble/curves@^2/secp256k1.js",
    "@anchr/protocol": "./packages/protocol/src/mod.ts",
    "@anchr/protocol/events": "./packages/protocol/src/events.ts",
    "@anchr/protocol/nostr": "./packages/protocol/src/nostr.ts",
    "@anchr/protocol/schema": "./packages/protocol/src/schema.ts",
    "@anchr/protocol/types": "./packages/protocol/src/types.ts",
    "@anchr/sdk": "./packages/sdk/src/index.ts",
    "@anchr/sdk/adapters": "./packages/sdk/src/adapters/mod.ts",
    "@anchr/sdk/adapters/cashu": "./packages/sdk/src/adapters/cashu.ts",
    "@anchr/sdk/adapters/nostr": "./packages/sdk/src/adapters/nostr/mod.ts",
    "@anchr/sdk/adapters/oracle-client": "./packages/sdk/src/adapters/oracle-client/index.ts",
    "@anchr/sdk/adapters/oracle-service": "./packages/sdk/src/adapters/oracle-service/index.ts",
    "@anchr/sdk/adapters/storage": "./packages/sdk/src/adapters/storage.ts",
    "@anchr/sdk/attachments": "./packages/sdk/src/attachments/mod.ts",
    "@anchr/sdk/attachments/blossom": "./packages/sdk/src/attachments/blossom.ts",
    "@anchr/sdk/payments": "./packages/sdk/src/payments/mod.ts",
    "@anchr/sdk/proofs": "./packages/sdk/src/proofs/mod.ts",
    "@anchr/sdk/schema": "./packages/sdk/src/schema.ts",
    "@anchr/sdk/customer": "./packages/sdk/src/customer.ts",
    "@anchr/sdk/provider": "./packages/sdk/src/provider.ts",
    "@anchr/sdk/oracle": "./packages/sdk/src/oracle.ts",
    "@anchr/sdk/testing": "./packages/sdk/src/testing/mod.ts"
  },
  "unstable": ["sloppy-imports", "detect-cjs"],
  "tasks": {
    "check": "deno check packages/ e2e/ scripts/",
    "test": "deno task test:unit && deno task test:integration && deno task test:e2e:protocol && deno task test:scripts && deno task test:examples",
    "publish:dry-run": "deno publish --dry-run --allow-dirty --config packages/protocol/deno.json && deno publish --dry-run --allow-dirty --config packages/sdk/deno.json",
    "test:unit": "deno test packages/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys '--ignore=**/*.integration.test.ts'",
    "test:integration": "bash -c 'files=$(find packages -name \"*.integration.test.ts\" -type f); if [ -z \"$files\" ]; then echo \"No package integration tests\"; exit 0; fi; deno test --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys $files'",
    "test:scripts": "deno test scripts/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:examples": "deno test --allow-all examples/examples.test.ts examples/sdk-public-api-dogfood.test.ts examples/",

    "test:e2e:protocol": "deno test e2e/protocol/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:relay": "ANCHR_E2E_REQUIRE_INFRA=1 deno test e2e/relay/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:regtest": "ANCHR_E2E_REQUIRE_INFRA=1 deno test e2e/regtest/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys --allow-ffi",
    "test:e2e:frost": "FROST_E2E_REQUIRE_CORE=1 deno test e2e/frost/ --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys",
    "test:e2e:tlsn": "TLSN_E2E_REQUIRE_CORE=1 deno test e2e/tlsn/ --allow-all",

    "test:all": "./scripts/test-all.sh --local",
    "test:all:docker": "./scripts/test-all.sh --docker",
    "test:all:full": "./scripts/test-all.sh full",

    "lint": "deno lint",
    "lint:strict": "deno lint && deno task lint:fmt && deno task lint:arch && deno task lint:invariants && deno task lint:paths && deno task lint:types && deno task lint:deprecation && deno task lint:no-history-comments && deno task lint:no-dynamic-import && deno task lint:no-test-sanitizer-bypass && deno task lint:no-unit-network-listener && deno task lint:proof-schema-pages",
    "lint:deps": "bash scripts/cargo-audit-all.sh",
    "lint:fmt": "deno run --allow-read --allow-run scripts/lint-fmt.ts",
    "lint:arch": "deno run --allow-read scripts/arch-lint.ts",
    "lint:arch:candidates": "deno run --allow-read scripts/arch-lint-candidates.ts",
    "lint:invariants": "deno run --allow-read scripts/lint-invariants.ts",
    "lint:paths": "deno run --allow-read --allow-env --allow-run scripts/check-no-local-paths.ts",
    "lint:types": "deno run --allow-read scripts/lint-types.ts",
    "lint:deprecation": "deno run --allow-read --allow-env --allow-run scripts/lint-deprecation.ts",
    "lint:no-history-comments": "deno run --allow-read --allow-env --allow-run scripts/lint-no-history-comments.ts",
    "lint:no-dynamic-import": "deno run --allow-read --allow-env --allow-run scripts/lint-no-dynamic-import.ts",
    "lint:no-test-sanitizer-bypass": "deno run --allow-read --allow-run scripts/lint-no-test-sanitizer-bypass.ts",
    "lint:no-unit-network-listener": "deno run --allow-read --allow-run scripts/lint-no-unit-network-listener.ts",
    "lint:proof-schema-pages": "deno run --allow-read scripts/check-proof-schema-pages.ts",
    "setup:hooks": "git config core.hooksPath scripts/git-hooks && echo '✓ git hooks installed (core.hooksPath → scripts/git-hooks)'"
  },
  "exclude": [
    ".worktrees/",
    "node_modules",
    "dist/",
    "packages/sdk/dist/"
  ],
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-eval",
        "no-self-compare",
        "default-param-last"
      ],
      "exclude": [
        "no-unused-vars",
        "require-await",
        "no-explicit-any",
        "no-slow-types",
        "jsx-button-has-type",
        "no-import-prefix"
      ]
    },
    "exclude": [
      "dist/",
      "packages/sdk/dist/",
      "scripts/"
    ]
  },
  "fmt": {
    "exclude": [
      "docs",
      "docs/issues",
      "*.md",
      "skills",
      ".claude/skills",
      ".codex/skills"
    ]
  },
  "nodeModulesDir": "auto"
}
