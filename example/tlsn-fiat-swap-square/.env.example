# Local non-production defaults for the TLSN fiat swap Square example.
NOSTR_RELAYS=ws://localhost:7777
CASHU_MINT_URL=http://localhost:3338
FIAT_SWAP_ORACLE_ENDPOINT=http://localhost:3001
FIAT_SWAP_ORACLE_PUBKEY=<oracle-pubkey-hex-or-npub>
FIAT_SWAP_ORACLE_API_KEY=<optional-oracle-api-key>

FIAT_SWAP_PROVIDER_PRIVKEY=<buyer-provider-nsec-or-hex>
FIAT_SWAP_PROVIDER_PUBKEY=
FIAT_SWAP_SOURCE_PROOFS_JSON=[{"placeholder":"replace-with-testnet-cashu-proof"}]

SQUARE_PAYMENT_LINK=https://square.link/u/test
SQUARE_ACCESS_TOKEN=<square-sandbox-access-token>
FIAT_SWAP_PAYMENT_ID=<square-payment-id-after-buyer-pays>
FIAT_SWAP_PROOF_FILE=proof.presentation.tlsn
FIAT_SWAP_PROOF_BASE64=
FIAT_SWAP_NOTARY_URL=

FIAT_SWAP_AMOUNT_SATS=1000
FIAT_SWAP_FIAT_AMOUNT_MINOR=100
FIAT_SWAP_FIAT_CURRENCY=JPY
FIAT_SWAP_SQUARE_LOCATION_ID=
FIAT_SWAP_MAX_ATTESTATION_AGE_SECONDS=600
FIAT_SWAP_LOCKTIME_SECONDS=3600
FIAT_SWAP_OFFER_WINDOW_MS=30000
FIAT_SWAP_RESULT_TIMEOUT_MS=300000
FIAT_SWAP_SELECTION_TIMEOUT_MS=60000
FIAT_SWAP_PREIMAGE_TIMEOUT_MS=300000
